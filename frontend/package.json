    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.1.18",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.3",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.13.1",
